{
  "$schema": "https://schema.tauri.app/2.0.0/tauri.conf.json",
  "productName": "FH6-Painter",
  "version": "0.1.0",
  "identifier": "com.fh6painter.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
          "title": "FH6-Painter",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "../../app_icon.ico"
    ]
  }
}
